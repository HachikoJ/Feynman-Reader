# Server-only variables. Never commit a real .env file or paste secrets into GitHub.
# PostgreSQL connection string. Use the local server after migration, or a
# managed PostgreSQL endpoint during the transition. Keep this server-only.
DATABASE_URL=postgresql://feynman_app:URL_ENCODED_DATABASE_PASSWORD@127.0.0.1:5432/feynman_reader

# Generate with: openssl rand -base64 32
FEYNMAN_AUTH_STATE_SECRET=replace-with-a-long-random-secret

# Generate with: openssl rand -base64 32
FEYNMAN_API_KEY_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key


# Watcha OAuth2 (观猹). Keep these values server-only.
TOKENDANCE_OAUTH_CLIENT_ID=
TOKENDANCE_OAUTH_CLIENT_SECRET=
TOKENDANCE_OAUTH_REDIRECT_URI=https://reader.deline.top/api/auth/tokendance/callback
TOKENDANCE_OAUTH_AUTHORIZE_URL=https://watcha.cn/oauth/authorize
TOKENDANCE_OAUTH_TOKEN_URL=https://watcha.cn/oauth/api/token
TOKENDANCE_OAUTH_USERINFO_URL=https://watcha.cn/oauth/api/userinfo

# Local HTTP development only. Leave unset in production; HTTPS requests
# automatically receive Secure cookies. The false override is ignored when
# NODE_ENV=production.
# FEYNMAN_COOKIE_SECURE=false

# Temporary local-only mode. Set to true only for a production deployment
# where OAuth is intentionally unavailable. Books and learning data stay in
# this browser's IndexedDB; remove it or set false, then rebuild, to restore
# account sign-in and cloud sync after the domain is ready.
# Do not enable this during ICP filing: filing mode uses username/password
# accounts. Set it to false or leave it unset for the filing deployment.
# NEXT_PUBLIC_FEYNMAN_LOCAL_AUTH_BYPASS=true

# During备案, disable Watcha OAuth while keeping username/password accounts.
# After approval, set the server flag to true and rebuild/deploy. deploy.sh
# embeds the same value in the browser build, disables all password endpoints,
# and exposes the one-time account migration in Account Center.
FEYNMAN_WATCHA_OAUTH_ENABLED=false

# During ICP filing keep Watcha and TokenDance hidden while the direct
# DeepSeek channel remains available. After approval switch all three values
# together: Watcha=true, TokenDance=true, DeepSeek official=false.
FEYNMAN_TOKENDANCE_ENABLED=false
FEYNMAN_DEEPSEEK_OFFICIAL_ENABLED=true

# Optional canonical origin used for administrator write-request Origin checks.
# Keep it aligned with the deployed public site.
FEYNMAN_PUBLIC_ORIGIN=https://reader.deline.top

# Administrator bootstrap is server-local only; never expose these in NEXT_PUBLIC_*.
# ADMIN_USER_ID=<existing app_users.id>
