{
  "name": "feynman-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8080",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/sanitize-static-export.mjs",
    "start": "python3 -m http.server 8080 --directory out --bind 127.0.0.1",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "verify:waf": "bash scripts/verify-safeline-rollout.sh",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.3",
    "openai": "^4.52.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
